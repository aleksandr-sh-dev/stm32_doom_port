{
    "version": "0.2.0",
    "projectName": "doom_port",
    "configurations":[
        {
            "name": "Debug: Bootloader",
            "type": "cortex-debug",
            "request": "launch",
            "showDevDebugOutput": "raw",
            "servertype": "stutil",
            "serverArgs": [],
            "device": "STM32F750N8",
            "interface": "swd",
            "runToEntryPoint": "main",
            "executable": "${workspaceFolder}/build_bootloader/stm32f7508_bootloader.elf",
            "cwd": "${workspaceFolder}",
            "svdFile": "STM32F750.svd",
            "swoConfig": {
                "enabled": true,
                "cpuFrequency": 216000000,
                "swoFrequency": 4000000,
                "source": "probe",
                "decoders": [
                    {
                        "label": "ITM port 0 output",
                        "type": "console",
                        "port": 0,
                        "showOnStartup": true,
                        "encoding": "ascii"
                    }
                ],
            }
        },
        {
            "name": "Debug: Application",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "stlink",
            "serverArgs": [
                "-s",
                "-m",
                "0",
                "-k",
                "--frequency",
                "21000",
                "-el", 
                "${workspaceFolder}/external_loader/N25Q128A_STM32F7508-DISCO.stldr"
            ],
            "showDevDebugOutput": "raw",
            "device": "STM32F750N8",
            "interface": "swd",
            "executable": "${workspaceFolder}/build/Debug/doom_port.elf",
            "cwd": "${workspaceFolder}",
            "svdFile": "STM32F750.svd",
            "runToEntryPoint": "main",
        }
    ]
}