{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Build: Debug",
                "Build: Bootloader"
            ],
        },
        {
            "label": "Build: Debug",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Debug"
            ],
            "command": "ninja",
            "args": [
                "doom_port",
                "-C",
                "${workspaceFolder}/build/Debug"
            ]
        },
        {
            "label": "Build: Bootloader",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "CMake: Bootloader"
            ],
            "command": "ninja",
            "args": [
                // "bootloader",
                "-C",
                "${workspaceFolder}/build_bootloader"
            ]
        },
        {
            "label": "Format Code",
            "type": "shell",
            "command": "find core app -type f \\( -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.hpp' \\) -exec clang-format -i -style=file {} +",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "Clean All",
            "type": "shell",
            "command": "rm -rf ${workspaceFolder}/build/ && rm -rf ${workspaceFolder}/build_bootloader",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        // HIDDEN INTERNAL TASKS
        {
            "label": "CMake: Debug",
            "type": "shell",
            "hide": true,
            "command": "/usr/bin/cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/gcc-arm-none-eabi.cmake",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/Debug",
                "-G", "Ninja"
            ]
        },
        {
            "label": "CMake: Bootloader",
            "type": "shell",
            "hide": true,
            "command": "/usr/bin/cmake",
            "args": [
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/gcc-arm-none-eabi.cmake",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS:BOOL=TRUE",
                "-S", "${workspaceFolder}/bootloader",
                "-B", "${workspaceFolder}/build_bootloader",
                "-G", "Ninja"
            ]
        },
    ]
}
